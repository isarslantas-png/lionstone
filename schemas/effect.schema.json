{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ismailarslantas/lionstone/schemas/effect.schema.json",
  "title": "Lionstone Effect Definition",
  "type": "object",
  "required": ["id", "name", "category", "tier", "style", "duration", "parameters", "constraints", "renderEngine", "supportsPreview", "fallback"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{2,3}$", "description": "Stable effect id. F = free, P = pro, S = studio." },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string" },
    "category": { "enum": ["title", "lower_third", "transition", "image", "audio", "caption"] },
    "tier": { "enum": ["free", "pro", "studio"] },
    "style": { "type": "array", "items": { "enum": ["cinematic", "dynamic", "minimal", "social", "corporate", "editorial", "documentary"] }, "minItems": 1 },
    "use": { "type": "array", "items": { "enum": ["intro", "chapter", "speaker_intro", "keypoint", "brand", "outro"] } },
    "duration": {
      "type": "object",
      "required": ["enter", "hold", "exit"],
      "properties": {
        "enter": { "type": "number", "minimum": 0, "maximum": 5 },
        "hold": { "type": "number", "minimum": 0, "maximum": 30 },
        "exit": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "parameters": { "type": "object" },
    "constraints": {
      "type": "object",
      "properties": {
        "minDuration": { "type": "number", "minimum": 0 },
        "maxDuration": { "type": "number", "minimum": 0 },
        "safeArea": { "type": "boolean" },
        "minFontPx": { "type": "integer", "minimum": 8 },
        "fullFrame": { "type": "boolean" }
      }
    },
    "renderEngine": { "enum": ["remotion", "ffmpeg", "html"] },
    "fallbackEngine": { "enum": ["ffmpeg", "none"] },
    "composition": { "type": "string", "description": "Remotion composition id" },
    "supportsPreview": { "type": "boolean" },
    "preview": { "type": "string" },
    "fallback": { "type": "string", "description": "Safe effect used if the primary renderer fails." },
    "license": { "type": "object", "properties": { "code": { "type": "string" }, "assets": { "type": "string" } } }
  }
}
